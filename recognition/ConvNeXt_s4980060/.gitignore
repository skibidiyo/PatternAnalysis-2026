# --- Model weights / checkpoints (never commit) ---
*.pth
*.pt
*.ckpt
*.bin
*.safetensors
*.onnx
checkpoints/

# --- Datasets (never commit) ---
data/
*.nii
*.nii.gz
*.npy
*.npz
*.h5
