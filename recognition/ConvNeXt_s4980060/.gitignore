# artefact, so it is tracked while the checkpoints and logs beside it are not.
!outputs/split_audit.json
runs/
logs/
wandb/
lightning_logs/
mlruns/
*.log
slurm-*.out
slurm-*.err

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# --- Environments ---
.venv/
venv/
env/
.env

